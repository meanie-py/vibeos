#!/usr/bin/env bash
# `swarm` on PATH → the vibeos agent-swarm CLI (agent_swarm package).
# Resolves relative to its own location and runs via PYTHONPATH (NOT pip-installed —
# avoids the worktree site-packages shadowing trap). Identity is resolved by the CLI.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # .../<repo>/bin
exec env PYTHONPATH="$here/../agent-swarm${PYTHONPATH:+:$PYTHONPATH}" python3 -m agent_swarm "$@"
