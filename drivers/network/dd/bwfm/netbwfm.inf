; NETBWFM.INF

; The Raspberry Pis' CYW43455 Wi-Fi: bwfm.sys, an NDIS 6 miniport (802.3 to the
; protocols; the chip is FullMAC). The arm64 HAL publishes the Pi 5's Wi-Fi SDIO host
; as VIBEOS\CYW43455 (hal-rust/src/arm64/pnpdd.rs). docs/engineering/pi-wifi-design.md.

[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %VibeOS%
DriverVer  = 10/17/2026,1.00

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%CypressMfg% = CypressMfg

[CypressMfg]
%CYW43455.DeviceDesc% = BWFM_Inst.ndi,VIBEOS\CYW43455

;----------------------------- BWFM DRIVER -----------------------------

[BWFM_Inst.ndi.NT]
Characteristics = 0x4 ; NCF_PHYSICAL
BusType = 0 ; Internal
AddReg = BWFM_AddReg.NT
CopyFiles = BWFM_CopyFiles.NT

[BWFM_CopyFiles.NT]
bwfm.sys

[BWFM_AddReg.NT]
HKR, Ndi,            Service,    0, "bwfm"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[BWFM_Inst.ndi.NT.Services]
AddService = bwfm, 0x00000002, BWFM_Service_Inst

[BWFM_Service_Inst]
ServiceType   = 1
StartType     = 3
ErrorControl  = 0
ServiceBinary = %12%\bwfm.sys
LoadOrderGroup = NDIS

;-------------------------------- STRINGS -------------------------------

[Strings]
VibeOS = "VibeOS"
CypressMfg = "Cypress"
CYW43455.DeviceDesc = "Cypress CYW43455 Wi-Fi (Raspberry Pi)"
