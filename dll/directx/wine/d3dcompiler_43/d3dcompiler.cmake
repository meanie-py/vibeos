function(add_d3dcompiler_target VERSION)
    set(_target d3dcompiler_${VERSION})
    set(_srcdir ${CMAKE_CURRENT_SOURCE_DIR}/../d3dcompiler_43)

    spec2def(${_target}.dll ${_target}.spec ADD_IMPORTLIB)

    # asmshader.l/.y declare their own "asmshader_" prefix (%option prefix and
    # %define api.prefix). Passing -p as well makes bison fail outright.
    FLEX_TARGET(${_target}_asmshader_scanner ${_srcdir}/asmshader.l
                ${CMAKE_CURRENT_BINARY_DIR}/asmshader.yy.c)
    BISON_TARGET(${_target}_asmshader_parser ${_srcdir}/asmshader.y
                 ${CMAKE_CURRENT_BINARY_DIR}/asmshader.tab.c
                 DEFINES_FILE ${CMAKE_CURRENT_BINARY_DIR}/asmshader.tab.h)
    ADD_FLEX_BISON_DEPENDENCY(${_target}_asmshader_scanner ${_target}_asmshader_parser)

    # ${_target}.dll is C, and cargo compiles and links it:
    # sdk/lib/rust/${_target}-cargo (reactos-link, generated by tools/cargo_cell_gen.py).
    # The C still compiled, in an OBJECT library whose compile the cargo link replays.
    # How cmake compiled the target's sources, now on the OBJECT libraries.
    # Generated inputs those compiles read, ordered before them.
    add_library(${_target}_shims OBJECT ${_srcdir}/asmparser.c ${_srcdir}/blob.c ${_srcdir}/bytecodewriter.c ${_srcdir}/compiler.c ${_srcdir}/reflection.c ${_srcdir}/utils.c ${CMAKE_CURRENT_BINARY_DIR}/asmshader.yy.c ${CMAKE_CURRENT_BINARY_DIR}/asmshader.tab.c)
    target_link_libraries(${_target}_shims PRIVATE wine dxguid uuid oldnames libd3dwine libmsvcrt libkernel32 libntdll)
    target_compile_definitions(${_target}_shims PRIVATE
        __WINESRC__
        __ROS_LONG64__
        D3D_COMPILER_VERSION=${VERSION})
    target_include_directories(${_target}_shims BEFORE PRIVATE
        ${REACTOS_SOURCE_DIR}/sdk/include/wine
        ${REACTOS_BINARY_DIR}/sdk/include/wine
        ${_srcdir}
        ${CMAKE_CURRENT_BINARY_DIR}
        ${VKD3D_INCLUDE_DIRS})
    add_dependencies(${_target}_shims wineheaders d3d_idl_headers)
    add_cargo_module(${_target} ${_target}-cargo ${_target}.dll
    KIND win32dll
    DESTINATION reactos/system32
    EXTRA_DEPENDS ${_target}_shims psdk uuid_sources)
endfunction()
