
function(add_d3dx10_forwarder VERSION)
    set(_target d3dx10_${VERSION})

    spec2def(${_target}.dll ${_target}.spec ADD_IMPORTLIB)

    # ${_target}.dll is C, and cargo compiles and links it:
    # sdk/lib/rust/${_target}-cargo (reactos-link, generated by tools/cargo_cell_gen.py).
    # The C still compiled, in an OBJECT library whose compile the cargo link replays.
    # How cmake compiled the target's sources, now on the OBJECT libraries.
    # Generated inputs those compiles read, ordered before them.
    add_library(${_target}_shims OBJECT ${REACTOS_SOURCE_DIR}/dll/directx/wine/${_target}/${_target}_main.c)
    target_link_libraries(${_target}_shims PRIVATE wine libmsvcrt libkernel32 libntdll)
    target_compile_definitions(${_target}_shims PRIVATE
        __WINESRC__
        __ROS_LONG64__)
    target_include_directories(${_target}_shims BEFORE PRIVATE
        ${REACTOS_SOURCE_DIR}/sdk/include/wine
        ${REACTOS_BINARY_DIR}/sdk/include/wine
        ${CMAKE_CURRENT_BINARY_DIR})
    add_dependencies(${_target}_shims wineheaders d3d_idl_headers)
    add_cargo_module(${_target} ${_target}-cargo ${_target}.dll
    KIND win32dll
    DESTINATION reactos/system32
    EXTRA_DEPENDS ${_target}_shims psdk)
endfunction()
