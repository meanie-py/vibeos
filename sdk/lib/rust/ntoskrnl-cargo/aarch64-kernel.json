{
  "abi": "llvm",
  "abi-return-struct-as-int": true,
  "allows-weak-linkage": false,
  "arch": "aarch64",
  "binary-format": "coff",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-p:64:64-i32:32-i64:64-i128:128-n32:64-S128-Fn32",
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": false,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "gnu",
  "exe-suffix": ".exe",
  "features": "+v8a,+neon,+outline-atomics",
  "frame-pointer": "always",
  "function-sections": false,
  "is-like-windows": true,
  "linker-flavor": "gnu-cc",
  "llvm-target": "aarch64-pc-windows-gnu",
  "max-atomic-width": 128,
  "metadata": {
    "description": "ReactOS aarch64 cargo-link target (gnullvm codegen, -nostdlib kernel)",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "os": "windows",
  "panic-strategy": "abort",
  "pre-link-args": {
    "gnu-cc": [
      "-fno-use-linker-plugin"
    ]
  },
  "requires-uwtable": false,
  "target-family": [
    "windows"
  ],
  "target-pointer-width": 64,
  "vendor": "pc"
}