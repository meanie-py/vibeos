# verifier_shims (arm64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/verifier/verifier.c	@build/dll/win32/verifier dll/win32/verifier @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 @core	UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
