# mspaint_shims (arm64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	base/applications/mspaint/rust_varargs_shim.c	@build/base/applications/mspaint base/applications/mspaint @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 @core	INITGUID UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DEBUG=1 _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
cxx	base/applications/mspaint/rust_cohab_stub.cpp	@build/base/applications/mspaint base/applications/mspaint @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include sdk/lib/atl	@core -fexceptions	INITGUID UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DEBUG=1 _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
