# netshell_shims (arm64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	dll/shellext/netshell/rust_cohab_stub.cpp	@build/dll/shellext/netshell dll/shellext/netshell @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include sdk/lib/atl	@core -fno-exceptions	UNICODE WINVER=0x502 _ATL_NO_EXCEPTIONS _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _NETSHELL_ _UNICODE _WIN32_WINNT=0x600 __USE_CRTIMP
