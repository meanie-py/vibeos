# uniata_shims (arm64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	drivers/storage/ide/uniata/rust_cohab_stub.cpp	@build/drivers/storage/ide/uniata drivers/storage/ide/uniata @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	@core -fno-exceptions -Wno-narrowing -Wno-unused-but-set-variable	WINVER=0x502 _CRT_NON_CONFORMING_SWPRINTFS _WIN32_WINNT=0x502
c	drivers/storage/ide/uniata/rust_varargs_shim.c	@build/drivers/storage/ide/uniata drivers/storage/ide/uniata @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 @core -Wno-narrowing -Wno-unused-but-set-variable	WINVER=0x502 _CRT_NON_CONFORMING_SWPRINTFS _WIN32_WINNT=0x502
