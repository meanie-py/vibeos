# dhcpcsvc_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	base/services/dhcpcsvc/rust_varargs_shim.c	@build/base/services/dhcpcsvc base/services/dhcpcsvc @std vendor/opengl-headers/include vendor/libdxg/include base/services/dhcpcsvc/include sdk/include/reactos/idl	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
c	@build/base/services/dhcpcsvc/dhcpcsvc_c.c	@build/base/services/dhcpcsvc base/services/dhcpcsvc @std vendor/opengl-headers/include vendor/libdxg/include base/services/dhcpcsvc/include sdk/include/reactos/idl	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
c	@build/base/services/dhcpcsvc/dhcpcsvc_s.c	@build/base/services/dhcpcsvc base/services/dhcpcsvc @std vendor/opengl-headers/include vendor/libdxg/include base/services/dhcpcsvc/include sdk/include/reactos/idl	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
