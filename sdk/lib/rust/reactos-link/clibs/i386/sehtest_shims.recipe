# sehtest_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	base/system/sehtest/sehtest.c	@build/base/system/sehtest base/system/sehtest @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 @core --target=i686-pc-windows-msvc -fasync-exceptions	WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
