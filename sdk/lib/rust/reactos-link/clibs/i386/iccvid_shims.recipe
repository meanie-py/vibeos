# iccvid_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/iccvid/iccvid.c	@build/dll/win32/iccvid dll/win32/iccvid @build/sdk/include/wine sdk/include/wine @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -isystem {REPO}/sdk/lib/tdilib -isystem {REPO}/vendor/zlib/include -isystem {REPO}/vendor/libtiff/include -std=gnu99 @core	WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP __WINESRC__
