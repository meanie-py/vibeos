# svchost_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	base/services/svchost/security.cxx	@build/base/services/svchost base/services/svchost @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	@core -fno-exceptions	UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
