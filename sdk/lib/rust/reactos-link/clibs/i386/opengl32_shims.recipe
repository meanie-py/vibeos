# opengl32_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
asm	dll/opengl/opengl32/glapi_x86.s	sdk/include/asm @build/sdk/include/asm @build/dll/opengl/opengl32 dll/opengl/opengl32 @std vendor/mesa	@core	BUILD_GL32 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _GDI32_ _GLAPI_NO_EXPORTS __USE_CRTIMP
