# lpk_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/lpk/bidi.c	@build/dll/win32/lpk dll/win32/lpk @std vendor/opengl-headers/include vendor/libdxg/include dll/win32/lpk/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	LANGPACK UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
c	dll/win32/lpk/direction.c	@build/dll/win32/lpk dll/win32/lpk @std vendor/opengl-headers/include vendor/libdxg/include dll/win32/lpk/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	LANGPACK UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
c	dll/win32/lpk/lpk.c	@build/dll/win32/lpk dll/win32/lpk @std vendor/opengl-headers/include vendor/libdxg/include dll/win32/lpk/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	LANGPACK UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
c	dll/win32/lpk/stub.c	@build/dll/win32/lpk dll/win32/lpk @std vendor/opengl-headers/include vendor/libdxg/include dll/win32/lpk/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	LANGPACK UNICODE WINVER=0x502 _UNICODE _WIN32_WINNT=0x502
