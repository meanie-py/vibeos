# netapi32_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	@build/dll/win32/netapi32/atsvc_c.c	@build/dll/win32/netapi32 dll/win32/netapi32 @std vendor/opengl-headers/include vendor/libdxg/include sdk/include/reactos/idl	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 @core	WIN32_LEAN_AND_MEAN= WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
