# cmicpl_shims (i386), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	vendor/cmidriver/cpl/cmicpl.cpp	@build/drivers/wdm/audio/drivers/CMIDriver/cpl vendor/cmidriver/cpl @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	@core -fno-exceptions	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
