# msxml6_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/msxml6/main.c	@build/dll/win32/msxml6 dll/win32/msxml6 @build/sdk/include/wine sdk/include/wine @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -isystem {REPO}/vendor/libxml2/include -isystem {REPO}/vendor/libxml2/include/libxml -isystem {REPO}/vendor/libwin-iconv -isystem {REPO}/vendor/zlib/include -isystem {REPO}/sdk/lib/tdilib -isystem {REPO}/vendor/libtiff/include -std=gnu99 -U_X86_ -UWIN32 @core	COM_NO_WINDOWS_H WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x601 _WINE __USE_CRTIMP
