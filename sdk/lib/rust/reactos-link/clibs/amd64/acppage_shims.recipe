# acppage_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	dll/shellext/acppage/rust_cohab_stub.cpp	@build/dll/shellext/acppage dll/shellext/acppage @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include dll/appcompat/apphelp sdk/lib/atl	@core -fno-exceptions	UNICODE WINVER=0x502 _ATL_NO_EXCEPTIONS _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
c	dll/shellext/acppage/rust_varargs_shim.c	@build/dll/shellext/acppage dll/shellext/acppage @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include dll/appcompat/apphelp	-std=gnu99 -U_X86_ -UWIN32 @core	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
