# framedyn_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/framedyn/main.c	@build/dll/win32/framedyn dll/win32/framedyn @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 -U_X86_ -UWIN32 @core	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
cxx	dll/win32/framedyn/chstring.cpp	@build/dll/win32/framedyn dll/win32/framedyn @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	@core -fexceptions	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
cxx	dll/win32/framedyn/provider.cpp	@build/dll/win32/framedyn dll/win32/framedyn @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	@core -fexceptions	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
