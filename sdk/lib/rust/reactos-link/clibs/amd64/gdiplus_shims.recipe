# gdiplus_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/win32/gdiplus/brush.c	@build/dll/win32/gdiplus dll/win32/gdiplus @build/sdk/include/wine sdk/include/wine @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 -U_X86_ -UWIN32 @core -Wno-incompatible-pointer-types	_CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _USE_MATH_DEFINES _WIN32_WINNT=0x601 __ROS_LONG64__ __USE_CRTIMP __WINESRC__ wcsicmp=_wcsicmp
