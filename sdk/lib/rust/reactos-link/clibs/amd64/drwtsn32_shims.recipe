# drwtsn32_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
cxx	base/applications/drwtsn32/rust_cohab_stub.cpp	@build/base/applications/drwtsn32 base/applications/drwtsn32 @std vendor/opengl-headers/include vendor/libdxg/include sdk/lib/udmihelp sdk/lib/dmilib sdk/lib/atl	-isystem {REPO}/sdk/lib/pseh/include @core -fexceptions	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
c	base/applications/drwtsn32/rust_varargs_shim.c	@build/base/applications/drwtsn32 base/applications/drwtsn32 @std vendor/opengl-headers/include vendor/libdxg/include sdk/lib/udmihelp sdk/lib/dmilib	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 -U_X86_ -UWIN32 @core	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
