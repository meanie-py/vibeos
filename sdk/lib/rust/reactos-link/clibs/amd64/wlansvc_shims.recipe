# wlansvc_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	@build/base/services/wlansvc/wlansvc_s.c	@build/base/services/wlansvc base/services/wlansvc @std vendor/opengl-headers/include vendor/libdxg/include sdk/include/reactos/idl	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 -U_X86_ -UWIN32 @core -Wno-cast-calling-convention	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
