# qmgrprxy_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	@build/dll/win32/qmgrprxy/qmgrprxy_i.c	@build/dll/win32/qmgrprxy dll/win32/qmgrprxy @build/sdk/include/wine sdk/include/wine @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 -U_X86_ -UWIN32 @core	WINE_REGISTER_DLL WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
c	@build/dll/win32/qmgrprxy/qmgrprxy_p.c	@build/dll/win32/qmgrprxy dll/win32/qmgrprxy @build/sdk/include/wine sdk/include/wine @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 -U_X86_ -UWIN32 @core	WINE_REGISTER_DLL WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
c	@build/dll/win32/qmgrprxy/proxy.dlldata.c	@build/dll/win32/qmgrprxy dll/win32/qmgrprxy @build/sdk/include/wine sdk/include/wine @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -std=gnu99 -U_X86_ -UWIN32 @core	WINE_REGISTER_DLL WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _WIN32_WINNT=0x502 __USE_CRTIMP
