# skiplist16 (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	sdk/lib/skiplist/rust_cohab_stub.c	@build/sdk/lib/skiplist sdk/lib/skiplist @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 -U_X86_ -UWIN32 @core	SKIPLIST_LEVELS=16 WINVER=0x502 _WIN32_WINNT=0x502
