# oleaut32_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	@build/dll/win32/oleaut32/proxy.dlldata.c	@build/dll/win32/oleaut32 dll/win32/oleaut32 @build/sdk/include/wine sdk/include/wine @std sdk/lib/pseh/include vendor/opengl-headers/include vendor/libdxg/include	-std=gnu99 -U_X86_ -UWIN32 @core	ENTRY_PREFIX=OLEAUTPS_ PROXY_CLSID=CLSID_PSFactoryBuffer PROXY_DELEGATION WINE_REGISTER_DLL WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _OLEAUT32_ _WIN32_WINNT=0x600 __USE_CRTIMP __WINESRC__
