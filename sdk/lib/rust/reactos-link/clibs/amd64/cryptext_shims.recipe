# cryptext_shims (amd64), from cmake's compile of it: tools/cargo_cell_gen.py --clib-recipes
c	dll/shellext/cryptext/cryptext.c	@build/dll/shellext/cryptext dll/shellext/cryptext @std vendor/opengl-headers/include vendor/libdxg/include	-isystem {REPO}/sdk/lib/pseh/include -isystem {REPO}/sdk/lib/tdilib -isystem {REPO}/vendor/zlib/include -isystem {REPO}/vendor/libtiff/include -std=gnu99 -U_X86_ -UWIN32 @core	UNICODE WINVER=0x502 _CRT_DECLARE_NONSTDC_NAMES=1 _CRT_NONSTDC_NO_DEPRECATE _DLL _UNICODE _WIN32_WINNT=0x502 __USE_CRTIMP
