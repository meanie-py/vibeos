[defines]
-DD3D_UMD_INTERFACE_VERSION=0x000C
-DDBG=1
-DDLL_EXPORT_VERSION=0x502
-DDXGKDDI_INTERFACE_VERSION=0x1052
-DMINGW_HAS_SECURE_API=1
-DUSE_COMPILER_EXCEPTIONS
-D_AMD64_
-D_CRT_SUPPRESS_RESTRICT
-D_GLIBCXX_HAVE_BROKEN_VSWPRINTF
-D_M_AMD64
-D_M_X64
-D_NEW_DELETE_OPERATORS_
-D_SEH_ENABLE_TRACE
-D_SETUPAPI_VER=0x502
-D_USE_DUMMY_PSEH=1
-D_WIN32_IE=0x603
-D_WIN32_WINDOWS=0x502
-D_WIN64
-D__REACTOS__
-D__x86_64__
