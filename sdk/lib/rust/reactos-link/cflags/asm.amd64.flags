# cmake's C rule, the part every C compile in the tree shares (amd64). Generated
# by python3 tools/cargo_cell_gen.py --c-template from build-<arch>/compile_commands.json;
# reactos-link's Linker::c_compiled adds the library's own includes, flags and defines.
[cc]
{REPO}/.build-tools/llvm-mingw/bin/x86_64-w64-mingw32-clang
[target]

[std]
sdk/include
sdk/include/crt
sdk/include/ddk
sdk/include/ndk
sdk/include/psdk
sdk/include/reactos
sdk/include/reactos/libs
sdk/include/vcruntime
sdk/include/winrt
@build/sdk/include
@build/sdk/include/psdk
@build/sdk/include/ddk
@build/sdk/include/dxsdk
@build/sdk/include/reactos
@build/sdk/include/reactos/mc
sdk/include/dxsdk
sdk/lib/pseh/include
vendor/opengl-headers/include
vendor/libdxg/include
[core]
-U_X86_
-UWIN32
-ffile-prefix-map={REPO}=
-ffile-prefix-map=../=
-pipe
-fms-extensions
-fno-strict-aliasing
-fno-common
-mlong-double-64
-nostdinc
-isystem{REPO}/sdk/include/crt
-isystem{REPO}/.build-tools/llvm-mingw/lib/clang/19/include
-fno-associative-math
-fno-builtin-stpcpy
-gdwarf-2
-gstrict-dwarf
-march=athlon64
-mtune=generic
-Wall
-Wpointer-arith
-Wno-char-subscripts
-Wno-multichar
-Wno-unused-value
-Wno-unused-const-variable
-Wno-unused-local-typedefs
-Wno-deprecated
-Wno-unused-result
-Wno-format
-Wno-maybe-uninitialized
-Wno-nonnull-compare
-Wno-pragma-pack
-Wno-unknown-warning-option
-O1
-mcx16
[defines]
-DD3D_UMD_INTERFACE_VERSION=0x000C
-DDBG=1
-DDLL_EXPORT_VERSION=0x502
-DDXGKDDI_INTERFACE_VERSION=0x1052
-DMINGW_HAS_SECURE_API=1
-DUSE_COMPILER_EXCEPTIONS
-DWINVER=0x502
-D_AMD64_
-D_CRT_SUPPRESS_RESTRICT
-D_GLIBCXX_HAVE_BROKEN_VSWPRINTF
-D_M_AMD64
-D_M_X64
-D_NEW_DELETE_OPERATORS_
-D_SEH_ENABLE_TRACE
-D_SETUPAPI_VER=0x502
-D_USE_DUMMY_PSEH=1
-D_WIN32_IE=0x603
-D_WIN32_WINDOWS=0x502
-D_WIN32_WINNT=0x502
-D_WIN64
-D__REACTOS__
-D__x86_64__
