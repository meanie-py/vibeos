--target=i686-w64-mingw32
-DD3D_UMD_INTERFACE_VERSION=0x000C
-DDBG=1
-DDLL_EXPORT_VERSION=0x502
-DDXGKDDI_INTERFACE_VERSION=0x1052
-DKDBG
-DLANGPACK
-DMINGW_HAS_SECURE_API=1
-DUSE_COMPILER_EXCEPTIONS
-DWINVER=0x502
-D_CRT_SUPPRESS_RESTRICT
-D_GLIBCXX_HAVE_BROKEN_VSWPRINTF
-D_M_IX86
-D_NEW_DELETE_OPERATORS_
-D_SEH_ENABLE_TRACE
-D_SETUPAPI_VER=0x502
-D_USE_32BIT_TIME_T
-D_USE_DUMMY_PSEH=1
-D_WIN32K_
-D_WIN32_IE=0x603
-D_WIN32_WINDOWS=0x502
-D_WIN32_WINNT=0x502
-D_X86_
-D__REACTOS__
-D__i386__
-Di386
-I{REPO}/win32ss
-I{REPO}/sdk/include
-I{REPO}/sdk/include/crt
-I{REPO}/sdk/include/ddk
-I{REPO}/sdk/include/ndk
-I{REPO}/sdk/include/psdk
-I{REPO}/sdk/include/reactos
-I{REPO}/sdk/include/reactos/libs
-I{REPO}/sdk/include/vcruntime
-I{REPO}/sdk/include/winrt
-I{REPO}/sdk/include/dxsdk
-I{REPO}/sdk/lib/pseh/include
-I{REPO}/vendor/opengl-headers/include
-I{REPO}/vendor/libdxg/include
-I{REPO}/win32ss/include
-I{REPO}/vendor/freetype/include
-I{REPO}/sdk/include/reactos/subsys
-I{REPO}/sdk/include/reactos/drivers
-std=gnu23
-ffile-prefix-map={REPO}=
-ffile-prefix-map=../=
-pipe
-fms-extensions
-fno-strict-aliasing
-fno-common
-mlong-double-64
-nostdinc
-isystem{REPO}/sdk/include/crt
-isystem{REPO}/.build-tools/llvm-mingw/lib/clang/19/include
-fno-associative-math
-fno-builtin-stpcpy
-gdwarf-2
-gstrict-dwarf
-march=pentium
-mtune=generic
-Wall
-Wpointer-arith
-Wno-char-subscripts
-Wno-multichar
-Wno-unused-value
-Wno-unused-const-variable
-Wno-unused-local-typedefs
-Wno-deprecated
-Wno-unused-result
-Wno-format
-Wno-maybe-uninitialized
-Wno-nonnull-compare
-Wno-microsoft
-Wno-pragma-pack
-Wno-unknown-warning-option
-O1
-fno-optimize-sibling-calls
-fno-omit-frame-pointer
-mstackrealign
-c
