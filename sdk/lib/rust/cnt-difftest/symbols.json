{
  "_atoi64": {
    "c_signature": "__int64 _atoi64(const char *nptr)",
    "family": "radix",
    "slice_pattern": "nul_in",
    "return_collapse": "i64_passthrough",
    "reference": "sdk/lib/crt/string/atoi64.c",
    "fuzz_domain": [
      "NULL",
      "empty",
      "ws+sign",
      "near i64::MAX",
      "i64 overflow wrap",
      "trailing junk",
      "no digits"
    ]
  },
  "atoi": {
    "c_signature": "int atoi(const char *s)",
    "family": "radix",
    "slice_pattern": "nul_in",
    "return_collapse": "i64_trunc_i32",
    "reference": "sdk/lib/crt/string/atoi64.c",
    "fuzz_domain": [
      "empty",
      "NULL",
      "leading ws + sign",
      "i32-overflow ('2147483648')",
      "i64-overflow ('99999999999999999999')",
      "trailing junk ('12abc')",
      "lone sign ('+','-')",
      "no digits ('  x')"
    ]
  },
  "atol": {
