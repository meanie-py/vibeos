{
  "abi-return-struct-as-int": true,
  "allows-weak-linkage": false,
  "arch": "x86",
  "binary-format": "coff",
  "cpu": "pentium",
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:32-n8:16:32-a:0:32-S32",
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": false,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "gnu",
  "exe-suffix": ".exe",
  "frame-pointer": "always",
  "function-sections": false,
  "is-like-windows": true,
  "linker-flavor": "gnu-cc",
  "llvm-target": "i686-pc-windows-gnu",
  "max-atomic-width": 64,
  "metadata": {
    "description": "32-bit ReactOS kernel target — strips user-mode CRT bits from i686-pc-windows-gnu",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "os": "windows",
  "panic-strategy": "abort",
  "pre-link-args": {
    "gnu-cc": [
      "-fno-use-linker-plugin"
    ]
  },
  "requires-uwtable": false,
  "rustc-abi": "x86-softfloat",
  "target-family": [
    "windows"
  ],
  "target-pointer-width": 32,
  "vendor": "pc"
}
