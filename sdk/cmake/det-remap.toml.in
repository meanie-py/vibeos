# GENERATED by cmake (configure_file from sdk/cmake/det-remap.toml.in) — do not edit.
#
# Per-worktree Rust path remap for reproducible / cross-worktree-byte-identical builds
# (deterministic-builds-plan.md rung 1, Rust side). rustc embeds the ABSOLUTE path of every
# source file (panic messages, debug info, file!()), so two worktrees building the same commit
# at different paths produce different bytes -> zero hardlink dedup. This maps THIS worktree's
# source root to a constant token, so the embedded paths are identical across worktrees.
#
# WHY --config / cfg(all()) and not trim-paths or RUSTFLAGS:
#   - `trim-paths` is unstable on cargo 1.92 (our pinned stable) — needs nightly opt-in, and
#     putting it in the shared workspace Cargo.toml breaks every stable consumer of the manifest.
#   - env RUSTFLAGS / [target.<triple>].rustflags would CLOBBER the load-bearing i386 SSE guard
#     (-C target-feature=-sse,-sse2). Cargo JOINS target.'cfg(all())' with target.<triple>
#     rustflags (verified), so this ADDS the remap without dropping the SSE guard.
#   - @REACTOS_SOURCE_DIR@ is the per-worktree source root expanded at configure time, so each
#     worktree maps its OWN root to the same /vibeos token (mirrors the C -ffile-prefix-map).
[target.'cfg(all())']
rustflags = ["--remap-path-prefix=@REACTOS_SOURCE_DIR@=/vibeos"]
