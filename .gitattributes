# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Files with these extensions are accepted source files inside the ReactOS
# tree. They should have native line endings of the OS.
*.acf text
*.asm text
*.c text
*.cc text
*.cmake text
*.cpp text
*.cxx text
*.h text
*.hpp text
*.hxx text
*.idl text
*.inc text
*.inl text
*.klc text
*.l text
*.lds text
*.md text
*.rc text
*.s text
*.S text
*.sfd text
*.spec text
*.svg text
*.txt text
*.TXT text
*.y text

# Files with these extensions must always have LF (Unix) line endings.
*.sh text eol=lf

# Files with these extensions end up in the built ReactOS system, so they
# need to have CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.exp text eol=crlf
*.hhc text eol=crlf
*.hhp text eol=crlf
*.ini text eol=crlf
*.INI text eol=crlf
*.inf text eol=crlf
*.inf.tpl text eol=crlf
*.js text eol=crlf
*.manifest text eol=crlf
*.mc text eol=crlf
*.mof text eol=crlf
*.rgs text eol=crlf
*.sif text eol=crlf
*.vbs text eol=crlf
*.vcxproj text eol=crlf
*.xml text eol=crlf

# Files with these extensions are accepted binary files inside the ReactOS
# tree. Git must not tamper with them at all!
*.avi binary
*.bin binary
*.bmf binary
*.bmp binary
*.BMP binary
*.chm binary
*.cur binary
*.dll binary
*.emf binary
*.gif binary
*.ico binary
*.jpg binary
*.mp3 binary
*.nls binary
*.otf binary
*.pdn binary
*.pfb binary
*.pfm binary
*.png binary
*.psd binary
*.ttc binary
*.ttf binary
*.wav binary
*.xcf binary

# All other extensions not explicitly mentioned here are left for Git to
# handle automatically.
# You must not rely on them having a particular line ending style!
# Vendored FEX snapshot: preserve upstream bytes exactly (no EOL normalization)
external/fex/** -text

# NO `merge=union` HERE — the field manual was the obvious candidate and it was WRONG.
#
# The problem union was meant to solve was real: every lane appended a new numbered section
# at the tail of the field manual, so every pair of concurrent lanes conflicted there on
# content neither one touched (three hand-resolutions in one night, 2026-07-25). Union kept
# both sides' lines and the merges went quiet.
#
# Then mainline consolidated the manual 13.4K -> 2.1K lines: topical sections, entries
# identified by HEADING, the global counter retired. Union does not diff — it concatenates —
# so against a restructuring merge it took both "before" and "after" and silently reverted
# the entire consolidation, producing a 12.4K-line file that still passed `git merge` with no
# conflict to look at. It was caught only because scan_doc_sections then reported 165 minted
# section numbers.
#
# The durable lesson: union is only safe while a file's merges are *guaranteed* disjoint
# appends, and nothing enforces that — one lane restructuring the file is enough to break the
# guarantee, with no signal. The append-at-EOF collision is now fixed at the source instead:
# entries go in the topical section their symptom belongs to, so two lanes rarely touch the
# same region, and `tools/scan_doc_sections.py --lint` fails a newly minted number.

# Vendor patches are BYTE-EXACT artifacts, not source. `* text=auto` above was
# silently stripping CR from the diff bodies of patches taken against CRLF trees,
# which made the committed patch fail to apply even though the working copy was
# verified — caught on stlport.patch, where 99 CR lines vanished on commit.
vendor-patches/*.patch -text

# Vendored LICENCE TEXTS are byte-exact artifacts too, and `*.txt text` above
# normalises them. EDK II ships its License.txt with CRLF; committing it through
# that rule silently produced a blob with a different sha256 from upstream's,
# which is the same failure `vendor-patches/*.patch` was given this treatment for
# (stlport, where 99 CR bytes vanished between the copy I verified and the copy I
# committed). The point is not the line endings — it is that vendor.yaml records
# an upstream sha256 for provenance, and a recorded hash that does not match the
# committed file is worse than no hash. Every other vendored licence file is LF
# upstream and needs no rule; add one here if that ever stops being true.
vendor/edk2/License.txt -text
COPYING.DJ -text
