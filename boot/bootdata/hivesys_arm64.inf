[AddReg]

; PL011 UART driver (ARM64 QEMU virt) — boot start so it's available before csrss
HKLM,"SYSTEM\CurrentControlSet\Services\pl011","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\pl011","Group",0x00000000,"Boot Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\pl011","ImagePath",0x00020000,"system32\drivers\pl011.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\pl011","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\pl011","Type",0x00010001,0x00000001

; ARM64 input stub driver — provides \Device\KeyboardClass0 and \Device\PointerClass0
; for Win32k RIT. Must load before csrss/winsrv creates desktop thread.
HKLM,"SYSTEM\CurrentControlSet\Services\arm64input","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\arm64input","Group",0x00000000,"Boot Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\arm64input","ImagePath",0x00020000,"system32\drivers\arm64input.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\arm64input","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\arm64input","Type",0x00010001,0x00000001

; ARM64 framebuffer video device driver — boot start so \Device\Video0 exists before csrss
HKLM,"SYSTEM\CurrentControlSet\Services\arm64vid","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\arm64vid","Group",0x00000000,"Boot Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\arm64vid","ImagePath",0x00020000,"system32\drivers\arm64vid.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\arm64vid","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\arm64vid","Type",0x00010001,0x00000001

; Root-enumerated PCI host bridge (QEMU virt GPEX). There is no acpi.sys on the
; arm64 boot path (x86 gets ACPI\PNP0A03 from the synthetic-RSDP ACPI stack), so
; seed the root devnode statically: pnproot creates a PDO from this key, the
; shared-hive CriticalDeviceDatabase entry *PNP0A03 -> pci binds pci.sys, and
; pci.sys enumerates the bus via HalGetBusData (ECAM, hal arm64 halstubs.rs).
; This is what makes the USB (EHCI-on-PCIe) input/storage stack reachable on arm64.
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\*PNP0A03\0000","HardwareID",0x00010000,"*PNP0A03"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\*PNP0A03\0000","DeviceDesc",0x00000000,"PCI Bus (root-enumerated)"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\*PNP0A03\0000","ConfigFlags",0x00010001,0x00000000

; PlugPlay (umpnpmgr, in `svchost -k DcomLaunch`) auto-starts. x86 gets there on first boot,
; when `setup -mini`'s EnableUserModePnpManager flips it to SERVICE_AUTO_START and starts it;
; the arm64 boot runs no setup (winlogon spawns explorer itself), so the hive says it up
; front. Without it every cfgmgr32 RPC failed RPC_S_SERVER_UNAVAILABLE and devmgmt, dxdiag
; and rapps exited 0x6BA.
HKLM,"SYSTEM\CurrentControlSet\Services\PlugPlay","Start",0x00010001,0x00000002
