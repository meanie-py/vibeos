#!/usr/bin/env bash
# Build the pinned native generator; Cargo checks source freshness and serializes builds.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Callers may be inside a cross-build environment or outside the checkout.
unset RUSTUP_TOOLCHAIN RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER CARGO_BUILD_TARGET
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS RUSTC_BOOTSTRAP
toolchain=$(sed -n 's/^channel *= *"\([^"]*\)".*/\1/p' "$repo/rust-toolchain.toml")
if [[ -z "$toolchain" ]]; then
    echo "codegen: missing pinned channel in $repo/rust-toolchain.toml" >&2
    exit 2
fi
export RUSTUP_TOOLCHAIN="$toolchain"
exec cargo run --quiet --offline --locked \
    --manifest-path "$repo/tools/vibeos-codegen/Cargo.toml" \
    --target-dir "$repo/.cache/vibeos-codegen/target" \
    -- --root "$repo" "$@"
