#!/usr/bin/env bash
#
# pre-push hook — GATE-BEFORE-LAND GUARD (T1.3, 2026-07-04).
#
# The North Star ("gate smoke ×3 before landing") used to be discipline; a lane
# landed arm64 with i386-only validation and master sat at ~1/5 arm64 green for
# a day. This hook makes it mechanism: a push that updates `master` must carry
# a TREE that a green FULL `vibeos-cli gate` has stamped (the gate writes
# $GIT_COMMON_DIR/vibeos-gate-stamps/<tree>.json on all-arches-green over a
# clean tree — one file per gated tree, so concurrent lanes never clobber each
# other's stamp; the legacy single-file vibeos-gate-stamp.json is still honored).
#
# Allowed without a matching stamp:
#   * pushes not touching master (lane branches)
#   * deletions
#   * inert-content-only deltas vs the stamped tree (.md/.txt/images — tools/docs_only.py;
#     ONE .py or .rs in the delta means the whole push gates, comment-only or not)
#   * VIBEOS_SKIP_GATE_CHECK=1 git push …   (escape hatch — use for emergencies
#     and say so in your report; the point is that skipping is a CHOICE, loud
#     and attributable, never a default)
#
# Lanes on older tooling (no stamp-writing gate.py yet): run a full
# `./vibeos-cli gate` after merging current master, or use the escape hatch
# once and merge soon. This hook lives in the COMMON git dir, so it guards
# every worktree of this clone.

[ "${VIBEOS_SKIP_GATE_CHECK:-}" = "1" ] && {
    echo "pre-push: VIBEOS_SKIP_GATE_CHECK=1 — gate check SKIPPED (report this)" >&2
    exit 0
}

remote="$1"

# NOTE: the ref updates arrive on STDIN, but `python3 -` needs stdin for the
# program text — so bash slurps the lines first and forwards them as argv.
mapfile -t ref_lines || true

exec python3 - "$remote" "${ref_lines[@]}" <<'PYEOF'
import json
import subprocess
import sys
import time
from pathlib import Path

MAX_AGE_S = 24 * 3600
FULL = {"i386", "amd64", "arm64"}
ZERO = "0" * 40


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()


def fail(msg):
    sys.stderr.write(
        "\npre-push: BLOCKED — master requires a green full gate\n"
        f"  {msg}\n"
        "  fix:   ./vibeos-cli gate        (all 3 arches green mints the stamp)\n"
        "  docs:  docs-only pushes pass automatically\n"
        "  skip:  VIBEOS_SKIP_GATE_CHECK=1 git push …  (emergency only — report it)\n\n"
    )
    sys.exit(1)


updates = []
for line in sys.argv[2:]:
    parts = line.split()
    if len(parts) != 4:
        continue
    local_ref, local_sha, remote_ref, remote_sha = parts
    if remote_ref == "refs/heads/master" and local_sha != ZERO:
        updates.append((local_sha, remote_sha))

if not updates:
    sys.exit(0)

common = Path(git("rev-parse", "--git-common-dir"))
if not common.is_absolute():
    common = Path(git("rev-parse", "--show-toplevel")) / common

# Content-addressed stamp store: a green full gate writes one file per gated
# TREE hash under vibeos-gate-stamps/, so concurrent lanes gating different
# trees no longer clobber a single shared slot (the 2026-07-07 race, where one
# lane's gate overwrote another's stamp between gate and push). The legacy
# single-file vibeos-gate-stamp.json is still honored during the cutover window.
# Collect every FRESH (<24h), FULL-arch stamp's tree into the validated set.
stamp_files = []
stamps_dir = common / "vibeos-gate-stamps"
if stamps_dir.is_dir():
    stamp_files.extend(sorted(stamps_dir.glob("*.json")))
legacy = common / "vibeos-gate-stamp.json"
if legacy.is_file():
    stamp_files.append(legacy)

now = time.time()
valid_trees = set()
for p in stamp_files:
    try:
        s = json.loads(p.read_text())
    except (OSError, ValueError):
        continue
    if now - s.get("time", 0) > MAX_AGE_S:
        continue
    if not FULL.issubset(set(s.get("arches", []))):
        continue
    if s.get("tree"):
        valid_trees.add(s["tree"])

if not valid_trees:
    fail("no fresh green full-gate stamp found — run ./vibeos-cli gate")


# The inert-suffix predicate is SHARED with land.py's lint preflight (tools/docs_only.py),
# so the two exemptions cannot drift apart. It replaced "under docs/ OR ends in .md": that
# judged the DIRECTORY, and this tree has seven files under docs/ that are not documents,
# three of them .rs. Nothing reads them today, which is a fact about this afternoon and not
# about the rule.
#
# FAIL CLOSED if the import fails. A guard that cannot evaluate its own exemption must
# demand the stamp, never grant the pass -- this hook is the last thing between an ungated
# tree and master.
try:
    sys.path.insert(0, git("rev-parse", "--show-toplevel") + "/tools")
    from docs_only import is_inert
except Exception:  # noqa: BLE001 -- any failure here means "no exemption", by design
    def is_inert(_path):
        return False


def nondocs_delta(base_tree, tree):
    """Non-docs paths that differ between base_tree and tree ([] = docs-only).
    None when base_tree can't be resolved."""
    if not base_tree:
        return None
    diff = git("diff", "--name-only", base_tree, tree)
    if not diff:
        return []
    return [p for p in diff.splitlines() if not is_inert(p)]


for sha, remote_sha in updates:
    tree = git("rev-parse", f"{sha}^{{tree}}")
    if not tree:
        fail(f"cannot resolve tree of {sha[:12]}")
    if tree in valid_trees:
        continue  # exactly a gated tree — the common case, now race-free
    # docs-only exemption: the push's non-docs content is acceptable if it is
    # already VALIDATED — docs-only vs EITHER baseline:
    #   * remote master (remote_sha): every non-docs path there was gated when it
    #     landed. Master is always fast-forward (the reference-transaction guard
    #     forbids rewinds), so remote_sha == current origin/master.
    #   * ANY fresh gated tree: preserves the "gate a tree, stack a docs commit,
    #     push both at once" flow.
    remote_tree = git("rev-parse", f"{remote_sha}^{{tree}}") if remote_sha and remote_sha != ZERO else ""
    if nondocs_delta(remote_tree, tree) == []:
        continue
    if any(nondocs_delta(t, tree) == [] for t in valid_trees):
        continue
    base = remote_tree or next(iter(valid_trees))
    fail(
        f"push tree {tree[:12]} adds non-docs changes vs {base[:12]} without a "
        f"matching gate stamp — gate this tree (./vibeos-cli gate)"
    )

sys.exit(0)
PYEOF
