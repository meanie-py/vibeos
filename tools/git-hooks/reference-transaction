#!/usr/bin/env bash
#
# reference-transaction hook — MAINLINE REWIND GUARD.
#
# Blocks any NON-fast-forward update to the shared mainline branches
# (continue-rust-port, master). This stops the footgun that rewound
# continue-rust-port ~81 commits to the 2024 fork point: an agent ran
# `git reset --hard origin/continue-rust-port` (or `git branch -f`) on the
# SHARED checkout with a STALE remote-tracking ref (no `git fetch` first),
# resetting mainline to an ancient cached value.
#
# Fast-forwards (normal landings) are allowed. A genuine rewind by
# control-plane is allowed via the escape hatch:
#     VIBEOS_ALLOW_MAINLINE_REWIND=1 git <cmd>
#
# NOTE: git reports the transaction's `old` value as 0000000 in the "prepared"
# phase (it isn't resolved yet for the files backend), so we CANNOT trust it.
# Instead we read the ref's ACTUAL current value with `git rev-parse` — at the
# prepared stage the transaction isn't committed, so that's the real pre-update
# value. FF-vs-rewind is then current-value-is-ancestor-of-new.

state="$1"
[ "$state" = "prepared" ] || exit 0                       # only veto while preparing
[ "${VIBEOS_ALLOW_MAINLINE_REWIND:-}" = "1" ] && exit 0   # control-plane escape hatch

zero="0000000000000000000000000000000000000000"
blocked=0

while read -r _old new ref; do
    case "$ref" in
        refs/heads/continue-rust-port|refs/heads/master) ;;
        *) continue ;;
    esac
    # Real current value (pre-commit). Empty = the branch doesn't exist yet → creation.
    cur="$(git rev-parse --verify --quiet "$ref" 2>/dev/null || true)"
    [ -z "$cur" ] && continue                             # branch creation — allow
    if [ "$new" = "$zero" ]; then
        echo "git-guard: refusing to DELETE protected mainline branch $ref" >&2
        blocked=1
        continue
    fi
    # Allow only a fast-forward: current must be an ancestor of the new value.
    if ! git merge-base --is-ancestor "$cur" "$new" 2>/dev/null; then
        echo "git-guard: BLOCKED non-fast-forward update to $ref" >&2
        echo "           ${cur:0:11} -> ${new:0:11}  (a rewind/force — likely a stale" >&2
        echo "           remote-tracking ref from a 'reset --hard origin/...' without fetch)." >&2
        echo "           Agents: NEVER reset/force mainline. To sync, use:" >&2
        echo "                   git fetch && git merge --ff-only origin/continue-rust-port" >&2
        echo "           Control-plane intentional rewind: prefix VIBEOS_ALLOW_MAINLINE_REWIND=1" >&2
        blocked=1
    fi
done

exit "$blocked"
