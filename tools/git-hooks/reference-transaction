#!/usr/bin/env bash
#
# reference-transaction hook — MAINLINE REWIND GUARD.
#
# Blocks any NON-fast-forward update to the shared mainline branch `master`.
# This stops the footgun that once rewound mainline ~81 commits to the 2024
# fork point: an agent ran `git reset --hard origin/master` (or `git branch -f`)
# on the SHARED checkout with a STALE remote-tracking ref (no `git fetch` first),
# resetting mainline to an ancient cached value.
#
# Fast-forwards and merges (normal landings) are allowed. A genuine intentional
# rewind is allowed via the escape hatch:
#     VIBEOS_ALLOW_MAINLINE_REWIND=1 git <cmd>
#
# NOTE: git reports the transaction's `old` value as 0000000 in the "prepared"
# phase (it isn't resolved yet for the files backend), so we CANNOT trust it.
# Instead we read the ref's ACTUAL current value with `git rev-parse` — at the
# prepared stage the transaction isn't committed, so that's the real pre-update
# value. FF-vs-rewind is then current-value-is-ancestor-of-new.

state="$1"
[ "$state" = "prepared" ] || exit 0                       # only veto while preparing
[ "${VIBEOS_ALLOW_MAINLINE_REWIND:-}" = "1" ] && exit 0   # control-plane escape hatch

# Ref-storage MAINTENANCE is not a rewind — don't veto it. `git pack-refs` (run
# directly or by auto-`gc`) migrates a loose ref into packed-refs, which the
# transaction reports as a DELETE of the loose ref (new=0000) even though the
# value is preserved. That tripped the delete guard below and made every commit/
# fetch spew "refusing to DELETE ... failed to run pack-refs / gc failed" while
# the real op still succeeded. Ref-packing can never rewind history, so allow it.
#
# We inspect ONLY the hook's direct parent (PPID) — never grandparents. The
# process that runs this hook is always the git subprocess performing the ref
# transaction, so PPID is always a git binary, never the invoking shell. Even
# under auto-`gc`, gc delegates ref-packing to a child `git pack-refs`, so the
# hook's parent is that pack-refs, not gc. Walking further up would read the
# caller's shell cmdline and could excuse a genuine `reset`/`branch -f`/`push`
# whenever that command line merely mentioned one of these words (it did — this
# very guard's own test string moved master once by exactly that mistake).
_maint_re='([ /]|git-)(pack-refs|maintenance)( |$)'
_pcmd="$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null)"
if printf '%s' "$_pcmd" | grep -Eq "$_maint_re"; then
    exit 0                                                # ref-maintenance — safe
fi

zero="0000000000000000000000000000000000000000"
blocked=0

while read -r _old new ref; do
    case "$ref" in
        refs/heads/master) ;;
        *) continue ;;
    esac
    # Real current value (pre-commit). Empty = the branch doesn't exist yet → creation.
    cur="$(git rev-parse --verify --quiet "$ref" 2>/dev/null || true)"
    [ -z "$cur" ] && continue                             # branch creation — allow
    if [ "$new" = "$zero" ]; then
        echo "git-guard: refusing to DELETE protected mainline branch $ref" >&2
        blocked=1
        continue
    fi
    # Allow only a fast-forward: current must be an ancestor of the new value.
    if ! git merge-base --is-ancestor "$cur" "$new" 2>/dev/null; then
        echo "git-guard: BLOCKED non-fast-forward update to $ref" >&2
        echo "           ${cur:0:11} -> ${new:0:11}  (a rewind/force — likely a stale" >&2
        echo "           remote-tracking ref from a 'reset --hard origin/...' without fetch)." >&2
        echo "           NEVER reset/force mainline. To sync, use:" >&2
        echo "                   git fetch && git merge master   (or: git pull)" >&2
        echo "           Intentional rewind: prefix VIBEOS_ALLOW_MAINLINE_REWIND=1" >&2
        blocked=1
    fi
done

exit "$blocked"
