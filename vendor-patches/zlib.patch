 {
     p_filefunc64_32->zfile_func64.zopen64_file = NULL;
@@ -255,3 +256,5 @@
     pzlib_filefunc_def->zerror_file = ferror_file_func;
     pzlib_filefunc_def->opaque = NULL;
 }
