# libsamplerate 0.1.9 — our delta from pristine upstream.
#
# Upstream: https://github.com/libsndfile/libsamplerate/releases/download/0.1.9/libsamplerate-0.1.9.tar.gz
#           sha256 0a7eb168e2f21353fb6d84da152e4512126f7dc48ccb0be80578c565413444c1
# Apply from sdk/lib/3rdparty/libsamplerate/ with: patch -p1 < vendor-patches/libsamplerate.patch
# (config.h is upstream's Win32/config.h; the hunk below is relative to that file.)
#
# VERSION — recorded as `unknown`, and there is NO honest probe for it. Our config.h
# says PACKAGE_VERSION "0.1.8", but so does upstream 0.1.9's OWN Win32/config.h: that
# file is hand-maintained, not a configure output, and upstream never bumped its version
# string. So the value is wrong at the source and copying it into a probe would just
# launder upstream's error into our registry.
#
# The tree is 0.1.9, established from the LICENCE BOUNDARY: every source header carries
# the 2-clause BSD notice and "Copyright (c) ...-2016", while 0.1.8 is LGPL-2.1 —
# libsamplerate relicensed AT 0.1.9. Diffing against 0.1.9 instead of 0.1.8 collapses the
# delta from "all 13 files differ" to three, which confirms it. (Our COPYING is already
# the BSD text, so the registry's recorded licence was right; only the version was
# missing.)
#
# WHAT WE ACTUALLY CHANGE — three files:
#
#   float_cast.h  Upstream defines inline lrint/lrintf for Windows inside a
#                 `#if defined(WIN32) || defined(_WIN32)` block that assumes MSVC. Under
#                 clang/mingw those collide with the real libm ones, so they are narrowed
#                 to `#ifdef _MSC_VER`. Cannot be a -D: it guards a DEFINITION, and no
#                 command-line macro removes a definition upstream emits unconditionally.
#
#   config.h      Upstream's Win32/config.h with our settings. Two portability bits
#                 (MSVC-only #pragma warning, HAVE_LRINT/HAVE_LRINTF on because clang has
#                 them) and, more importantly, a KERNEL-MODE shim: `#define exit(n)
#                 __debugbreak()` and `#define printf DbgPrint`. That is not cosmetic —
#                 libsamplerate is linked into kmixer.sys, a kernel driver, where neither
#                 exit() nor printf exists. Anyone re-vendoring must keep this or the
#                 driver will not link.
#
#   precomp.h     Ours; no upstream counterpart, so it is not in this patch.
#
# DE-PATCHED 2026-09-20: samplerate.c, src_linear.c, src_sinc.c and src_zoh.c had their
# include blocks replaced by a single `#include "precomp.h"`. That was the manual half of
# something the build already does — `add_pch(libsamplerate precomp.h SOURCE)` becomes
# CMake's target_precompile_headers, which force-includes precomp.h on clang. All four are
# restored to pristine and rebuild clean with zero warnings, and libsamplerate's consumers
# (wdmaud.drv, kmixer.sys) still build. Same leftover pattern as libtiff: if you meet
# `#include "precomp.h"` atop a vendored .c, check for add_pch before assuming it matters.
#
--- a/float_cast.h
+++ b/float_cast.h
@@ -149,6 +149,7 @@
 	**	Therefore implement inline versions of these functions here.
 	*/
 
+#ifdef _MSC_VER
 	__inline long int
 	lrint (double flt)
 	{	int intgr ;
@@ -172,6 +173,7 @@
 
 		return intgr ;
 	}
+#endif
 
 #elif (defined (__MWERKS__) && defined (macintosh))
 
--- a/config.h
+++ b/config.h
@@ -27,9 +27,9 @@
 ** src/src_sinc.c this slows down compile times considerably. The
 ** following #pragma disables the warning.
 */
-
+#ifdef _MSC_VER
 #pragma warning(disable: 4305)
-
+#endif
 /*----------------------------------------------------------------------------
 ** Normal #defines follow.
 */
@@ -86,10 +86,10 @@
 /* #undef HAVE_LIBM */
 
 /* Define if you have C99's lrint function. */
-/* #undef HAVE_LRINT */
+#define HAVE_LRINT 1
 
 /* Define if you have C99's lrintf function. */
-/* #undef HAVE_LRINTF */
+#define HAVE_LRINTF 1
 
 /* Define to 1 if you have the `malloc' function. */
 #define HAVE_MALLOC 1
@@ -195,3 +195,15 @@
 */
 
 #define inline __inline
+
+/* ReactOS hacks */
+#ifndef __debugbreak
+void __cdecl __debugbreak(void);
+#endif
+unsigned long __cdecl DbgPrint(const char *Format, ...);
+#define exit(n) __debugbreak()
+#define printf DbgPrint
+
+# ifdef _MSC_VER
+#  pragma warning(disable:4244)
+# endif /* _MSC_VER */
