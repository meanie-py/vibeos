# libxml2 2.12.8 — our delta from pristine upstream.
#
# Upstream: https://download.gnome.org/sources/libxml2/2.12/libxml2-2.12.8.tar.xz
# Apply from sdk/lib/3rdparty/libxml2/ with: patch -p1 < vendor-patches/libxml2.patch
#
# WHY THIS IS A PATCH AND NOT A BUILD FLAG:
#   xmlschemas.c wraps the content-model determinism check in `#if 0`, which no -D can
#   express — you cannot define away a branch upstream does not gate. Note the comment
#   says "disabled in Wine": it arrived already-patched in the bulk import, not from
#   here. libxml.h and win32config.h COULD be de-patched by supplying the config.h
#   that pristine libxml.h already asks for, but that gains little while xmlschemas.c
#   still needs a patch, and `config.h` is a dangerously generic name to put on this
#   tree's include path (sdk/include/wine ships one too).
#
--- a/libxml.h
+++ b/libxml.h
@@ -23,10 +23,24 @@
 #endif
 
 /*
+ * XML_HIDDEN must be defined before including win32config.h, because
+ * win32config.h includes <io.h> which can resolve to private/io.h
+ * (via include paths) and that header uses XML_HIDDEN.
+ */
+#if !defined(_WIN32) && \
+    !defined(__CYGWIN__) && \
+    (defined(__clang__) || \
+     (defined(__GNUC__) && (__GNUC__ >= 4)))
+  #define XML_HIDDEN __attribute__((visibility("hidden")))
+#else
+  #define XML_HIDDEN
+#endif
+
+/*
  * These files are generated by the build system and contain private
  * and public build configuration.
  */
-#include "config.h"
+#include "win32config.h"
 #include <libxml/xmlversion.h>
 
 /*
@@ -43,15 +57,6 @@
   #include "trio.h"
 #endif
 
-#if !defined(_WIN32) && \
-    !defined(__CYGWIN__) && \
-    (defined(__clang__) || \
-     (defined(__GNUC__) && (__GNUC__ >= 4)))
-  #define XML_HIDDEN __attribute__((visibility("hidden")))
-#else
-  #define XML_HIDDEN
-#endif
-
 #if defined(__clang__) || \
     (defined(__GNUC__) && (__GNUC__ >= 8))
   #define ATTRIBUTE_NO_SANITIZE(arg) __attribute__((no_sanitize(arg)))
--- a/include/win32config.h
+++ b/include/win32config.h
@@ -5,6 +5,9 @@
 #define HAVE_STAT
 #define HAVE_FCNTL_H
 
+#include <io.h>
+#include <direct.h>
+
 #if defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER >= 1600)
   #define HAVE_STDINT_H
 #endif
--- a/xmlschemas.c
+++ b/xmlschemas.c
@@ -13133,12 +13133,14 @@
 	    XML_SCHEMAP_INTERNAL,
 	    WXS_BASIC_CAST type, type->node,
 	    "Failed to compile the content model", NULL);
+#if 0  /* disabled in Wine */
     } else if (xmlRegexpIsDeterminist(type->contModel) != 1) {
         xmlSchemaPCustomErr(ctxt,
 	    XML_SCHEMAP_NOT_DETERMINISTIC,
 	    /* XML_SCHEMAS_ERR_NOTDETERMINIST, */
 	    WXS_BASIC_CAST type, type->node,
 	    "The content model is not determinist", NULL);
+#endif
     } else {
     }
     ctxt->state = NULL;
@@ -20128,7 +20130,7 @@
 		WXS_BASIC_CAST ause, ause->node,
 		"ref", ref->name, ref->targetNamespace,
 		XML_SCHEMA_TYPE_ATTRIBUTE, NULL);
-            return(ctxt->err);;
+            return(ctxt->err);
         }
     }
     return(0);
@@ -28821,7 +28823,7 @@
         xmlCtxtUseOptions(pctxt, options);
 #endif
 
-    inputStream = xmlNewIOInputStream(pctxt, input, enc);;
+    inputStream = xmlNewIOInputStream(pctxt, input, enc);
     if (inputStream == NULL) {
         ret = -1;
 	goto done;
