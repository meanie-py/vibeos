# ACPICA 20260408 — our delta from pristine upstream.
#
# Upstream: https://github.com/open-acpica/acpica release 20260408 (the acpica/acpica
#           org redirects there). Archive sha256
#           ddc5d3e0f54030e2348484fff681861a161efb4e388e20631209574e7884ad39 — but see
#           the note on GitHub archive stability under wdf.patch: the release tag is the
#           identifier, the round-trip below is the check.
# Apply from drivers/bus/acpi/acpica/ with: patch -p1 < vendor-patches/acpica.patch
#
# SIX FILES, 173 LINES, all host-port shims. That is the entire ReactOS delta across a
# 226-file, 120K-line tree. Nothing here touches ACPI table or AML parsing, bounds
# checking or allocation.
#
# ----------------------------------------------------------------------------------
# READ THIS FIRST: THE LICENCE BLOCK IS SUBSTITUTED, NOT PATCHED
# ----------------------------------------------------------------------------------
#
# Every one of the 226 files carries the pre-SPDX "Linux-format" ACPICA licence header
# — short BSD-3-Clause conditions, the "Alternatively ... GPL version 2" arm, and a NO
# WARRANTY disclaimer — which Intel generates itself via ACPICA's generate/linux
# tooling and which Linux shipped verbatim through v4.x. Upstream's own tarball ships
# the long form instead: numbered sections 1-4, patent grant, 3.1-3.5 redistribution
# conditions, export compliance. Same dual licence, ~120 more lines per file.
#
# So a naive diff against the tarball reports ALL 226 files differing and 35,271
# changed lines. Strip the licence block from both sides and it is 95 files and 4,070
# lines; apply the six shims below and it is ZERO. Verified that way on 2026-09-20.
#
# THE SUBSTITUTION IS MECHANICAL AND EXACTLY STATABLE. In every file there is exactly
# one leading comment block containing both "Intel Corp" and a NO WARRANTY disclaimer
# — checked, 226 of 226, and at the same block index in both forms. Replace that one
# block with the Linux-format block, whose text after year-normalisation is IDENTICAL
# in all 226 files (one 36-line form, no variants). Its START year is always 2000 —
# that is the Linux form, regardless of the 1999 upstream writes in most files — and
# its END year is whatever upstream uses in that same file (2026 in 225 of them, 2023
# in one). That is the whole transform.
#
# IT NOW ROUND-TRIPS EXACTLY, which the previous ACPICA patch deliberately did not:
# pristine 20260408 + that substitution + this patch reproduces all 226 files
# BYTE-FOR-BYTE, verified 2026-09-20 with zero rejects and zero fuzz. Getting the start
# year wrong is the one way to fail it, and it fails loudly — all 226 files differ.
#
# WHY NOT JUST TAKE UPSTREAM'S FORM: it costs +1.49 MB of licence boilerplate across
# the tree, and upstream has ALREADY DELETED it — master converted to a one-line
# `SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only` after the 20260408 release.
# So the next bump past a release carrying that conversion sheds this whole problem,
# and the short SPDX tag is machine-readable by `vendored.py --licences` into the
# bargain. Until then, keep substituting.
#
# ----------------------------------------------------------------------------------
# WHAT CHANGED IN THIS BUMP (20221020 -> 20260408, 2026-09-20)
# ----------------------------------------------------------------------------------
#
# THE SEVENTH SHIM IS GONE. hardware/hwgpe.c used to carry the only unguarded
# non-header code edit in the tree: a `(UINT64)` cast on RegisterBit inside
# ACPI_CLEAR_BIT, which could not change the low 8 bits of the UINT8 EnableMask and was
# almost certainly a truncation-warning silencer. The previous review said it was
# "worth dropping or marking next time someone is in there". Dropped: the file is now
# pristine and all three arches compile it with no warning at all.
#
# All three arches build and BOOT TO THE DESKTOP MARKER with this drop. ACPICA is on
# the boot path, so that is the gate that matters, not the compile.
#
# The six remaining shims, unchanged in substance:
#   acpi.h      pulls in <ntddk.h> and #undefs ACPI_BIOS_ERROR, which acoutput.h
#               redefines.
#   acenv.h     picks ACPI_OSL_MUTEX, and (the one UNGUARDED edit left) widens the
#               compiler-select #if to accept __clang__ and to exclude WIN64, so a
#               clang/mingw PE64 build lands on acwin64.h rather than acgcc.h.
#   acgcc.h     supplies the x86 inline-asm cache flush and Global Lock that upstream
#               leaves to the host.
#   acmsvc.h    the same pair in MSVC __asm form, for _M_IX86.
#   acwin.h     suppresses upstream's MSVC versions of both, since ours live in
#               acmsvc.h.
#   acwin64.h   reimplements them with __wbinvd() and Interlocked*, which is standard
#               ACPICA port practice for 64-bit Windows.
#
# 187 upstream files are not vendored at all — ASL compiler, disassembler, debugger,
# tools, OS service layers — none of which a runtime kernel driver needs.
#
--- a/include/acpi.h
+++ b/include/acpi.h
@@ -8,6 +8,14 @@
 #ifndef __ACPI_H__
 #define __ACPI_H__
 
+#if defined(__REACTOS__) && !defined(UNIT_TEST)
+/*
+ * Header inclusion HACK.
+ */
+#include <ntddk.h>
+#undef ACPI_BIOS_ERROR  // ACPI_BIOS_ERROR is redefined in acoutput.h
+#endif /* __REACTOS__ */
+
 /*
  * Public include files for use by code that will interface to ACPICA.
  *
--- a/include/platform/acenv.h
+++ b/include/platform/acenv.h
@@ -150,7 +150,7 @@
  *
  *****************************************************************************/
 
-#if defined(__GNUC__) && !defined(__INTEL_COMPILER)
+#if (defined(__GNUC__) || defined(__clang__)) && !defined(__INTEL_COMPILER) && !defined(WIN64)
 #include "acgcc.h"
 
 #elif defined(_MSC_VER)
@@ -246,7 +246,11 @@
 /* Type of mutex supported by host. Default is binary semaphores. */
 
 #ifndef ACPI_MUTEX_TYPE
+#ifdef __REACTOS__
+#define ACPI_MUTEX_TYPE             ACPI_OSL_MUTEX
+#else
 #define ACPI_MUTEX_TYPE             ACPI_BINARY_SEMAPHORE
+#endif /* __REACTOS__ */
 #endif
 
 /* Global Lock acquire/release */
--- a/include/platform/acgcc.h
+++ b/include/platform/acgcc.h
@@ -88,4 +88,55 @@
 #define ACPI_NONSTRING __attribute__((__nonstring__))
 #endif
 
+#ifdef __REACTOS__
+/* Flush CPU cache - used when going to sleep. Wbinvd or similar. */
+
+#ifdef ACPI_APPLICATION
+#define ACPI_FLUSH_CPU_CACHE()
+#else
+#define ACPI_FLUSH_CPU_CACHE()  asm ("WBINVD")
+#endif
+
+/*
+ * Global Lock acquire/release code
+ *
+ * Note: Handles case where the FACS pointer is null
+ */
+#define ACPI_ACQUIRE_GLOBAL_LOCK(FacsPtr, Acq)              \
+do {                                                        \
+    asm("orl    %2,%2;"                                     \
+        "jz     2f;"                                        \
+        "leal   16(%2),%2;"                                 \
+        "1:"                                                \
+        "movl   (%2),%%eax;"                                \
+        "movl   %%eax,%%edx;"                               \
+        "andl   %3,%%edx;"                                  \
+        "btsl   $0x1,%%edx;"                                \
+        "adcl   $0x0,%%edx;"                                \
+        "lock;  cmpxchgl %%edx,(%2);"                       \
+        "jnz    1b;"                                        \
+        "cmpb   $0x3,%%dl;"                                 \
+        "sbbl   %%eax,%%eax;"                               \
+        "2:"                                                \
+        :"=a"(Acq):"a"(0xFF),"c"(FacsPtr),"i"(~1L):"edx");\
+} while(0)
+
+#define ACPI_RELEASE_GLOBAL_LOCK(FacsPtr, Acq)              \
+do {                                                        \
+    asm("orl    %2,%2;"                                     \
+        "jz     2f;"                                        \
+        "leal   16(%2),%2;"                                 \
+        "1:"                                                \
+        "movl  (%2),%%eax;"                                 \
+        "movl   %%eax,%%edx;"                               \
+        "andl   %3,%%edx;"                                  \
+        "lock;  cmpxchgl %%edx,(%2);"                       \
+        "jnz    1b;"                                        \
+        "cmpb   $0x3,%%dl;" /* FIXME: this is pointless */  \
+        "andl   $0x1,%%eax;"                                \
+        "2:"                                                \
+        :"=a"(Acq):"a"(0),"c"(FacsPtr),"i"(~3L):"edx");\
+} while(0)
+
+#endif /* __REACTOS__ */
 #endif /* __ACGCC_H__ */
--- a/include/platform/acmsvc.h
+++ b/include/platform/acmsvc.h
@@ -112,6 +112,69 @@
 #endif
 #endif
 
+#ifdef __REACTOS__
+#ifdef _M_IX86
+/* Flush CPU cache - used when going to sleep. Wbinvd or similar. */
+
+#ifdef ACPI_APPLICATION
+#define ACPI_FLUSH_CPU_CACHE()
+#else
+#define ACPI_FLUSH_CPU_CACHE()  __asm {WBINVD}
+#endif
+
+/*
+ * Global Lock acquire/release code
+ *
+ * Note: Handles case where the FACS pointer is null
+ */
+#define ACPI_ACQUIRE_GLOBAL_LOCK(FacsPtr, Acq)  __asm \
+{                                                   \
+        __asm mov           eax, 0xFF               \
+        __asm mov           ecx, FacsPtr            \
+        __asm or            ecx, ecx                \
+        __asm jz            exit_acq                \
+        __asm lea           ecx, [ecx].GlobalLock   \
+                                                    \
+        __asm acq10:                                \
+        __asm mov           eax, [ecx]              \
+        __asm mov           edx, eax                \
+        __asm and           edx, 0xFFFFFFFE         \
+        __asm bts           edx, 1                  \
+        __asm adc           edx, 0                  \
+        __asm lock cmpxchg  dword ptr [ecx], edx    \
+        __asm jnz           acq10                   \
+                                                    \
+        __asm cmp           dl, 3                   \
+        __asm sbb           eax, eax                \
+                                                    \
+        __asm exit_acq:                             \
+        __asm mov           Acq, al                 \
+}
+
+#define ACPI_RELEASE_GLOBAL_LOCK(FacsPtr, Pnd) __asm \
+{                                                   \
+        __asm xor           eax, eax                \
+        __asm mov           ecx, FacsPtr            \
+        __asm or            ecx, ecx                \
+        __asm jz            exit_rel                \
+        __asm lea           ecx, [ecx].GlobalLock   \
+                                                    \
+        __asm Rel10:                                \
+        __asm mov           eax, [ecx]              \
+        __asm mov           edx, eax                \
+        __asm and           edx, 0xFFFFFFFC         \
+        __asm lock cmpxchg  dword ptr [ecx], edx    \
+        __asm jnz           Rel10                   \
+                                                    \
+        __asm cmp           dl, 3                   \
+        __asm and           eax, 1                  \
+                                                    \
+        __asm exit_rel:                             \
+        __asm mov           Pnd, al                 \
+}
+#endif /* _M_IX86 */
+#endif /* __REACTOS__ */
+
 /* warn C4001: use of slash-slash comments */
 /* NOTE: MSVC 2015 headers use these extensively */
 #pragma warning(disable:4001)
--- a/include/platform/acwin.h
+++ b/include/platform/acwin.h
@@ -102,11 +102,13 @@
 
 /*! [Begin] no source code translation  */
 
+#ifndef __REACTOS__
 #ifdef ACPI_APPLICATION
 #define ACPI_FLUSH_CPU_CACHE()
 #else
 #define ACPI_FLUSH_CPU_CACHE()  __asm {WBINVD}
 #endif
+#endif /* __REACTOS__ */
 
 #ifdef _DEBUG
 #define ACPI_SIMPLE_RETURN_MACROS
@@ -114,6 +116,7 @@
 
 /*! [End] no source code translation !*/
 
+#ifndef __REACTOS__
 /*
  * Global Lock acquire/release code
  *
@@ -164,5 +167,6 @@
         __asm exit_rel:                             \
         __asm mov           Pnd, al                 \
 }
+#endif /* __REACTOS__ */
 
 #endif /* __ACWIN_H__ */
--- a/include/platform/acwin64.h
+++ b/include/platform/acwin64.h
@@ -69,6 +69,7 @@
 
 /*! [Begin] no source code translation  */
 
+#ifndef __REACTOS__
 #define ACPI_FLUSH_CPU_CACHE()
 
 /*
@@ -85,6 +86,46 @@
 
 #endif
 
+#else /* __REACTOS__ */
+
+#ifdef ACPI_APPLICATION
+#define ACPI_FLUSH_CPU_CACHE()
+#else
+#define ACPI_FLUSH_CPU_CACHE()  __wbinvd()
+#endif
+
+#define ACPI_ACQUIRE_GLOBAL_LOCK(FacsPtr, Acq) \
+{ \
+    BOOLEAN acquired = 0xFF; \
+\
+    if ((FacsPtr) != 0) \
+    { \
+        UINT32 compare, prev, newval; \
+        UINT32* lock = &((FacsPtr)->GlobalLock); \
+        do \
+        { \
+            compare = *lock; \
+            newval = (compare & ~1) | ((compare >> 1) & 1) | 2; \
+            prev = InterlockedCompareExchange(lock, newval, compare); \
+        } while (prev != compare); \
+        acquired = ((newval & 0xFF) < 3) ? 0xFF : 0x00; \
+    } \
+    (Acq) = acquired; \
+}
+
+#define ACPI_RELEASE_GLOBAL_LOCK(FacsPtr, Pnd) \
+{ \
+    BOOLEAN pending = 0; \
+\
+    if ((FacsPtr) != 0) \
+    { \
+        pending = InterlockedAnd(&(FacsPtr)->GlobalLock, ~3) & 1; \
+    } \
+    (Pnd) = pending; \
+}
+
+#endif /* __REACTOS__ */
+
 /*! [End] no source code translation !*/
 
 #endif /* __ACWIN_H__ */
